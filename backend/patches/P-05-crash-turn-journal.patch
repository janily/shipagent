@@ -0,0 +1,23 @@
+// Private on-disk turn lease, serialized with explicit persistence boundaries.
+import { access, writeFile, rm } from 'node:fs/promises';
+import { join } from 'node:path';
+const pending = new Map<string, Promise<void>>();
+const marker = (directory: string) => join(directory, '.active-turn');
+export async function flushTurnJournal(directory: string, active: () => boolean, persist: () => Promise<void>): Promise<void> {
+ const prior = pending.get(directory) ?? Promise.resolve();
+ const next = prior.catch(() => {}).then(async () => {
+  if (active()) {
+   // Exclusive creation never truncates an acknowledged turn's existing lease.
+   try { await writeFile(marker(directory), '', { flag: 'wx', mode: 0o600 }); }
+   catch (error) { if ((error as NodeJS.ErrnoException).code !== 'EEXIST') throw error; }
+  }
+  await persist(); // Errors retain the lease; never equate a failed save with completion.
+  if (!active()) await rm(marker(directory), { force: true });
+ });
+ pending.set(directory, next);
+ try { await next; } finally { if (pending.get(directory) === next) pending.delete(directory); }
+}
+export async function recoverInterruptedTurn(directory: string): Promise<boolean> {
+ try { await access(marker(directory)); return true; }
+ catch (error) { if ((error as NodeJS.ErrnoException).code === 'ENOENT') return false; throw error; }
+}
