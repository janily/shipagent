+ let acknowledged=false;
+ await expect(manager.sendMessage(managed.id,'fixture',undefined,undefined,undefined,undefined,undefined,()=>{acknowledged=true})).rejects.toThrow('journal-unwritable');
+ expect(managed.isProcessing).toBe(false); expect(acknowledged).toBe(false);
+});
