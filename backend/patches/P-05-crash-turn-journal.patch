+ const { SessionManager, createManagedSession } = await import('./SessionManager');
+ type Managed = ReturnType<typeof createManagedSession>;
+ type Harness = { sessions: Map<string,Managed>; ensureMessagesLoaded(s:Managed):void; nextTimestamp():number; flushSession(id:string):Promise<void>; sendMessage: InstanceType<typeof SessionManager>['sendMessage'] };
+ const managed = createManagedSession({id:'journal-failure'}, {id:'workspace',slug:'workspace',name:'Test',rootPath:'/unused',createdAt:1});
+ const manager = Object.create(SessionManager.prototype) as Harness;
