+import { test, expect } from 'bun:test';
+import { mkdtemp, rm, writeFile } from 'node:fs/promises';
+import { join } from 'node:path';
+import { tmpdir } from 'node:os';
+import { flushTurnJournal, recoverInterruptedTurn } from './turn-journal';
+async function fixture(run: (root: string) => Promise<void>) { const root = await mkdtemp(join(tmpdir(), 'shipagent-turn-journal-')); try { await run(root); } finally { await rm(root, {recursive:true,force:true}); } }
+test('acknowledged active turn survives restart, successful idle flush clears it', () => fixture(async root => {
+ expect(await recoverInterruptedTurn(root)).toBe(false);
+ await flushTurnJournal(root, () => true, async () => {});
+ expect(await recoverInterruptedTurn(root)).toBe(true);
+ await flushTurnJournal(root, () => true, async () => {});
+ expect(await recoverInterruptedTurn(root)).toBe(true);
+ await flushTurnJournal(root, () => false, async () => {});
+ expect(await recoverInterruptedTurn(root)).toBe(false);
+}));
+test('failed persistence retains recovery evidence, and empty marker is conservatively active', () => fixture(async root => {
+ await writeFile(join(root, '.active-turn'), '');
+ await expect(flushTurnJournal(root, () => false, async () => { throw Error('save-failed'); })).rejects.toThrow('save-failed');
+ expect(await recoverInterruptedTurn(root)).toBe(true);
+}));
+test('old idle flush cannot remove a newer active turn during an overlapping save', () => fixture(async root => {
+ let active=false, release!: () => void, entered!: () => void;
+ const gate = new Promise<void>(resolve => release=resolve);
+ const started = new Promise<void>(resolve => entered=resolve);
+ const old = flushTurnJournal(root, () => active, async () => { entered(); await gate; });
+ await started; active=true;
+ const next = flushTurnJournal(root, () => active, async () => {});
+ release(); await Promise.all([old,next]);
+ expect(await recoverInterruptedTurn(root)).toBe(true);
+}));
+
