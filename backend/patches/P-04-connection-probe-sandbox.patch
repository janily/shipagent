@@ -0,0 +1,29 @@
+import { test, expect } from 'bun:test';
+import { mkdir, writeFile, stat, realpath } from 'node:fs/promises';
+import { tmpdir, homedir } from 'node:os';
+import { dirname, basename, join } from 'node:path';
+import { withConnectionProbeWorkspace } from './connection-probe-workspace.ts';
+
+test('probe writes only to a unique temporary workspace and removes it on success', async () => {
+  let observed = '';
+  const answer = await withConnectionProbeWorkspace(async cwd => {
+    observed = cwd;
+    expect(dirname(cwd)).toBe(await realpath(tmpdir()));
+    expect(cwd).not.toBe(await realpath(homedir()));
+    expect(basename(cwd).startsWith('shipagent-connection-test-')).toBe(true);
+    await mkdir(join(cwd, 'sessions'));
+    await writeFile(join(cwd, 'sessions', 'fixture.json'), '{}');
+    return 42;
+  });
+  expect(answer).toBe(42);
+  expect(await stat(observed).then(() => false, () => true)).toBe(true);
+});
+test('failed construction or completion still removes the workspace', async () => {
+  let observed = '';
+  await expect(withConnectionProbeWorkspace(async cwd => { observed = cwd; throw new Error('fixture-failure'); })).rejects.toThrow('fixture-failure');
+  expect(await stat(observed).then(() => false, () => true)).toBe(true);
+});
+test('concurrent tests do not share a directory', async () => {
+  const roots = await Promise.all([0, 1].map(() => withConnectionProbeWorkspace(async cwd => cwd)));
+  expect(roots[0]).not.toBe(roots[1]);
+});
