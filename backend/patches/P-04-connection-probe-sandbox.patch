+++ b/packages/shared/src/agent/backend/connection-probe-workspace.ts
@@ -0,0 +1,19 @@
+// Connection validation must never create sessions in the user's home/workspace.
+import { mkdtemp, realpath, rm } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+
+export async function withConnectionProbeWorkspace<T>(run: (cwd: string) => Promise<T>): Promise<T> {
+  const cwd = await realpath(await mkdtemp(join(tmpdir(), 'shipagent-connection-test-')));
+  try {
+    return await run(cwd);
+  } finally {
+    await rm(cwd, { recursive: true, force: true, maxRetries: 10, retryDelay: 50 });
+  }
+}
+
+// Windows holds a child's cwd open until its exit is observed.
+export async function disposeConnectionProbe(agent: { destroy(): void; disposeForRestart?(): Promise<void> }): Promise<void> {
+  try { await agent.disposeForRestart?.(); }
+  finally { agent.destroy(); }
+}
