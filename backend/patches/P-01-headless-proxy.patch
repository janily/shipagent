+// Headless network setup. No Electron imports or session.setProxy side effects.
+import { Agent, Dispatcher, ProxyAgent, setGlobalDispatcher } from 'undici/index.js'
+import { getNetworkProxySettings } from '@mkagent/shared/config/storage'
+import type { NetworkProxySettings } from '@mkagent/shared/config/types'
+import { parseNoProxyRules, shouldBypassProxy, type NoProxyRule } from './headless-proxy-utils'
+
+class ProtocolProxyDispatcher extends Dispatcher {
+  private httpProxy: ProxyAgent | null;
+  private httpsProxy: ProxyAgent | null;
+  private direct: Agent;
+  private rules: NoProxyRule[];
+
+  constructor(opts: {
+    httpProxy?: string;
+    httpsProxy?: string;
+    noProxy?: string;
+  }) {
+    super();
+    this.httpProxy = opts.httpProxy ? new ProxyAgent(opts.httpProxy) : null;
+    this.httpsProxy = opts.httpsProxy ? new ProxyAgent(opts.httpsProxy) : null;
+    this.direct = new Agent();
+    this.rules = parseNoProxyRules(opts.noProxy);
+  }
+
+  dispatch(opts: Dispatcher.DispatchOptions, handler: Dispatcher.DispatchHandler): boolean {
+    const url = typeof opts.origin === 'string' ? opts.origin : opts.origin?.toString();
+
+    // If URL matches bypass rules, go direct
+    if (url && shouldBypassProxy(url, this.rules)) {
+      return this.direct.dispatch(opts, handler);
+    }
+
+    // Route based on protocol
+    const isHttps = url?.startsWith('https:');
+    const proxy = isHttps ? (this.httpsProxy ?? this.httpProxy) : this.httpProxy;
+
+    if (proxy) {
+      return proxy.dispatch(opts, handler);
+    }
+
+    return this.direct.dispatch(opts, handler);
+  }
+
+  async close(): Promise<void> {
+    await Promise.all([
+      this.httpProxy?.close(),
+      this.httpsProxy?.close(),
+      this.direct.close(),
+    ]);
+  }
+
+  async destroy(): Promise<void> {
+    await Promise.all([
+      this.httpProxy?.destroy(),
+      this.httpsProxy?.destroy(),
+      this.direct.destroy(),
+    ]);
+  }
+}
+
+const originalFetch = globalThis.fetch
+let current: Dispatcher | undefined
+/** Startup-only: apply protocol and NO_PROXY routing before the first fetch. */
+export function configureHeadlessProxy(settings: NetworkProxySettings | undefined): void {
+  try {
+    if (current) throw new Error('Proxy configuration requires process restart')
+    const enabled = settings?.enabled === true
+    const http = enabled ? settings.httpProxy?.trim() : undefined
+    const https = enabled ? settings.httpsProxy?.trim() : undefined
+    const rules = parseNoProxyRules(enabled ? settings?.noProxy : undefined)
+    const next = enabled && (http || https)
+      ? new ProtocolProxyDispatcher({ httpProxy: http, httpsProxy: https, noProxy: settings.noProxy })
+      : new Agent()
+    {
+      for (const [upper,lower,value] of [['HTTP_PROXY','http_proxy',http],['HTTPS_PROXY','https_proxy',https],['NO_PROXY','no_proxy',enabled ? settings?.noProxy : undefined]] as const) {
+        process.env[upper]=value ?? ''; process.env[lower]=value ?? ''
+      }
+    }
+    process.env.ALL_PROXY=''; process.env.all_proxy=''
+    setGlobalDispatcher(next)
+    current=next
+    if (typeof Bun !== 'undefined') {
+      globalThis.fetch = new Proxy(originalFetch, { apply(target, receiver, args: Parameters<typeof fetch>) {
+        const [input, init] = args
+        const url = typeof input === 'string' ? input : input instanceof URL ? input.toString() : input.url
+        const selected = shouldBypassProxy(url, rules) ? undefined : new URL(url).protocol === 'https:' ? (https || http) : http
+        // Empty proxy explicitly disables ambient env proxying for direct/bypassed requests.
+        const explicit = (init as (RequestInit & {proxy?:string}) | undefined)?.proxy
+        return Reflect.apply(target, receiver, [input, {...init, proxy: explicit ?? selected ?? ''}])
+      } }) as typeof fetch
+    }
+  } catch {
+    // Proxy URLs can contain credentials; never propagate constructor errors or payloads.
+    throw new Error('Unable to apply saved network proxy settings')
+  }
+}
+/** Called by the standalone entry point before bootstrap starts network services. */
+export function applySavedProxyToProcess(): void { configureHeadlessProxy(getNetworkProxySettings()) }
