+import type { RpcServer } from '@mkagent/server-core/transport'
+import { RPC_CHANNELS } from '@mkagent/shared/protocol'
+import { setNetworkProxySettings, CONFIG_DIR } from '@mkagent/shared/config/storage'
+import type { NetworkProxySettings } from '@mkagent/shared/config/types'
+import { readFileSync } from 'node:fs'
+import { join } from 'node:path'
+function readConfig(): Record<string,unknown> {
+  const config=JSON.parse(readFileSync(join(CONFIG_DIR,'config.json'),'utf8'))
+  if(!config || !Array.isArray(config.workspaces) || !config.workspaces.every((w:unknown)=>!!w && typeof w==='object' && ['id','name','rootPath'].every(key=>typeof (w as Record<string,unknown>)[key]==='string'))) throw new Error()
+  return config
+}
+function persist(write:()=>void, matches:(saved:Record<string,unknown>)=>boolean):void {
+  try { readConfig(); write(); if(!matches(readConfig()))throw new Error() }
+  catch { throw new Error('Unable to save headless settings') }
+}
+function validateProxy(value: unknown): asserts value is NetworkProxySettings {
+  if (!value || typeof value !== 'object' || Array.isArray(value)) throw new Error('Invalid network proxy settings')
+  const input = value as Record<string, unknown>
+  if (typeof input.enabled !== 'boolean') throw new Error('Invalid network proxy settings')
+  for (const key of ['httpProxy','httpsProxy','noProxy']) {
+    if (input[key] !== undefined && typeof input[key] !== 'string') throw new Error('Invalid network proxy settings')
+  }
+  for (const key of ['httpProxy','httpsProxy']) {
+    const proxy = (input[key] as string | undefined)?.trim()
+    if (!proxy) continue
+    try {
+      const url = new URL(proxy)
+      if (!['http:','https:'].includes(url.protocol) || !url.hostname) throw new Error()
+      decodeURIComponent(url.username); decodeURIComponent(url.password)
+    } catch { throw new Error('Invalid network proxy settings') }
+  }
+}
+/** Standalone-only handlers; Electron continues registering its GUI implementation. */
+export function registerHeadlessDesktopHandlers(server: Pick<RpcServer,'handle'>): void {
+  server.handle(RPC_CHANNELS.settings.SET_NETWORK_PROXY, (_ctx, value: unknown) => {
+    validateProxy(value)
+    const normalized={enabled:value.enabled,httpProxy:value.httpProxy?.trim()||undefined,httpsProxy:value.httpsProxy?.trim()||undefined,noProxy:value.noProxy?.trim()||undefined}
+    persist(()=>setNetworkProxySettings(value), config=>JSON.stringify(config.networkProxy ?? {enabled:false})===JSON.stringify(normalized))
+    return {restartRequired:true}
+  })
+}
