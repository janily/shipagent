+import { expect, test } from 'bun:test'
+import { mkdtempSync, rmSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { createSession, loadSession, saveSession, listSessions } from '@mkagent/shared/sessions'
+import { SessionManager, createManagedSession } from './SessionManager'
+
+type Managed = ReturnType<typeof createManagedSession>
+type Harness = {
+  sessions: Map<string,Managed>
+  ensureMessagesLoaded(session:Managed):void
+  toStored(session:Managed):NonNullable<ReturnType<typeof loadSession>>
+  flushSession(id:string):Promise<void>
+  markPendingPlanExecutionDispatched(id:string):Promise<boolean>
+}
+async function fixture(root:string, awaiting:boolean, dispatched:boolean) {
+  const config=await createSession(root)
+  const stored=loadSession(root,config.id)!
+  stored.pendingPlanExecution={planPath:join(root,'plan.md'),draftInputSnapshot:'preserved draft',awaitingCompaction:awaiting,executionDispatched:dispatched}
+  await saveSession(stored)
+  const metadata=listSessions(root).find(s=>s.id===config.id)!
+  const managed=createManagedSession(metadata,{id:'w',slug:'w',name:'Test',rootPath:root,createdAt:1})
+  const manager=Object.create(SessionManager.prototype) as Harness
+  manager.sessions=new Map([[managed.id,managed]])
+  manager.flushSession=async()=>{await saveSession(manager.toStored(managed))}
+  return {manager,managed}
+}
+test('cold metadata preserves durable readiness and draft on first read/write; claim is atomic',async()=>{
+  const root=mkdtempSync(join(tmpdir(),'plan-recovery-'))
+  try{
+    const {manager,managed}=await fixture(root,false,false)
+    expect(managed.messagesLoaded).toBe(false)
+    expect(managed.pendingPlanExecution).toBeUndefined()
+    const results=await Promise.all([manager.markPendingPlanExecutionDispatched(managed.id),manager.markPendingPlanExecutionDispatched(managed.id)])
+    expect(results).toEqual([true,false])
+    expect(managed.messagesLoaded).toBe(true)
+    expect(loadSession(root,managed.id)?.pendingPlanExecution).toMatchObject({awaitingCompaction:false,executionDispatched:true,draftInputSnapshot:'preserved draft'})
+    // A normal metadata write after lazy loading must not erase a restored record.
+    const again=createManagedSession(listSessions(root)[0]!,managed.workspace)
+    manager.ensureMessagesLoaded(again)
+    await saveSession(manager.toStored(again))
+    expect(loadSession(root,managed.id)?.pendingPlanExecution?.executionDispatched).toBe(true)
+  }finally{rmSync(root,{recursive:true,force:true})}
+})
+test('restored awaiting, busy and previously claimed plans never grant a second claim',async()=>{
+  for(const [awaiting,dispatched,busy] of [[true,false,false],[false,true,false],[false,false,true]]){
+    const root=mkdtempSync(join(tmpdir(),'plan-recovery-'))
+    try{const {manager,managed}=await fixture(root,awaiting!,dispatched!);managed.isProcessing=busy!;expect(await manager.markPendingPlanExecutionDispatched(managed.id)).toBe(false)}finally{rmSync(root,{recursive:true,force:true})}
+  }
+})
